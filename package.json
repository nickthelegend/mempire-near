{
  "name": "mempire-near",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mempire/app dev",
    "build": "pnpm --filter @mempire/app build",
    "preview": "pnpm --filter @mempire/app preview",
    "build:contract": "cd packages/contract && cargo near build non-reproducible-wasm --no-abi",
    "test:contract": "cd packages/contract && cargo test",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "meta:keep": "tsx scripts/meta-keep.ts",
    "meta:post": "tsx scripts/meta-keep.ts --once"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
