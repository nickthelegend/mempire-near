{
  "name": "mempire-near",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contract": "cd packages/contract && cargo near build non-reproducible-wasm --no-abi",
    "test:contract": "cd packages/contract && cargo test",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "meta:keep": "tsx scripts/oracle-refresh.ts --keep",
    "meta:post": "tsx scripts/oracle-refresh.ts",
    "meta:relayer-keep": "tsx scripts/meta-keep.ts",
    "meta:relayer-post": "tsx scripts/meta-keep.ts --once",
    "oracle:upgrade": "tsx scripts/oracle-upgrade.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@meteorwallet/sdk@1.0.24": "patches/@meteorwallet__sdk@1.0.24.patch"
    }
  }
}
